          {
            "enrichment": "no_candidates_unreviewed",
            "grade": "uncommitted",
            "memory_requests": [],
            "quote": {
              "text": "I'd like to know more about the role of film critics in the distribution and marketing process. How do they influence the success of a film, and what's the current state of film criticism in the age of social media and online reviews?"
            },
            "said_on": "2021-06-01",
            "sequence": 3,
            "source_id": "80856-1791157919486367000-1043"
          },
          {
            "enrichment": "pending",
            "grade": "uncommitted",
            "memory_requests": [],
            "quote": {
              "text": "I'd love to know more about the impact of film festivals on the careers of filmmakers and the industry as a whole. As someone who's attended several festivals, including SIFF, I've seen firsthand how these events can launch careers and generate buzz around new films. Can you tell me more about how film festivals can help filmmakers get their start, and what role they play in shaping the industry's future?"
            },
            "said_on": "2021-06-01",
